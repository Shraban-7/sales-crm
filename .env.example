# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Default production settings for maximum security.
APP_NAME="Sale Fusion CRM"
APP_ENV=production
# Leave blank here; generate with `php artisan key:generate`
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-crm-domain.com

# -----------------------------------------------------------------------------
# Main Administrator Credentials:
# Email:             superadmin@salescrm.test
# Password:          Set via CRM_ADMIN_PASSWORD below before running seeder
# -----------------------------------------------------------------------------
# Demo Accounts & Credentials (Seeded via `php artisan db:seed --class=DemoCrmSeeder`)
# Set CRM_DEMO_PASSWORD below before running the demo seeders.
# -----------------------------------------------------------------------------
# Super Admin:       demosuperadmin@salescrm.test
# Org Admin:         demoadmin@salescrm.test
# Sales Manager:     demomanager@salescrm.test
# Sales Executive:   demorep@salescrm.test
# SMB Executive:     demosmbrep@salescrm.test
# Read-Only Analyst: demoanalyst@salescrm.test
# -----------------------------------------------------------------------------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database (MySQL 8.0+)
# For Docker Compose, set DB_HOST=db and define DB_ROOT_PASSWORD below.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sales_crm
DB_USERNAME=crm_user
DB_PASSWORD=
# Used only by docker-compose.yml MySQL container initialization
DB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, Cache, Queue & Storage
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (SMTP / Log)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Optional Object Storage (S3-compatible)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Sale Fusion CRM Domain Settings & Webhooks
# -----------------------------------------------------------------------------
CRM_DEFAULT_CURRENCY=BDT
CRM_DEFAULT_COUNTRY=BD
CRM_PER_PAGE=20
CRM_QUOTE_DISCOUNT_THRESHOLD=15.00
CRM_QUOTE_PREFIX=QT
CRM_QUOTE_PUBLIC_LINK_DAYS=30
# Set a strong random HMAC-SHA256 signing secret before enabling POST /api/leads/capture
CRM_LEAD_WEBHOOK_SECRET=
CRM_LEAD_CAPTURE_TEAM_ID=
CRM_LEAD_ROUND_ROBIN=true
CRM_AUDIT_RETENTION_DAYS=365
CRM_REPORT_CACHE_TTL=300
# Main Administrator credentials password (superadmin@salescrm.test)
# Required: Operator must set a strong unique password before running migrations/seeders.
CRM_ADMIN_PASSWORD=
# Demo accounts password override (leave blank to use seeder default)
CRM_DEMO_PASSWORD=
# Set to true for live marketplace demonstration (landing page at root, demo credentials on login).
# Set to false for private purchased client deployments (bypasses landing page, clean login).
CRM_DEMO_MODE=false
# Verified site owner email: only this email has full administrative write permissions when CRM_DEMO_MODE=false
CRM_OWNER_EMAIL=owner@yourdomain.com
